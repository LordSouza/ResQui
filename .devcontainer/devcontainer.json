{
  "name": "ResQui Dev",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "dev",
  "runServices": ["postgres", "dev"],
  "workspaceFolder": "/workspaces/resqui",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  // Sem docker-outside-of-docker: essa feature montaria o socket do Docker
  // do host dentro do container, dando ao container controle total do
  // Docker do host — quebra o isolamento. Sem acesso a Docker de dentro
  // do dev container por design.
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  "forwardPorts": [5173, 5000, 5432],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite dev server)" },
    "5000": { "label": "Backend .NET" },
    "5432": { "label": "PostgreSQL" }
  },

  // O instalador do Claude Code coloca o binário em ~/.local/bin, que nem
  // sempre está no PATH de shells não-login — garantimos explicitamente.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },

  "postCreateCommand": "cd frontend && npm install && cd ../backend && dotnet restore && curl -fsSL https://claude.ai/install.sh | bash",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
