# Copie para .env antes de `docker compose up`:  cp .env.example .env
# Gere uma chave forte (>= 32 bytes), ex.: openssl rand -base64 48
JWT_KEY=

# Senha do admin semeado (admin@resqui.local) no primeiro start
ADMIN_PASSWORD=

# Opcional — senha do Postgres do container (default: resqui_dev)
# POSTGRES_PASSWORD=
ASSISTENTE_ENABLED=
DEEPSEEK_API_KEY=

EMAIL_ENABLED=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=resqui@resqui.local
EMAIL_REQUIRE_TLS=true
EMAIL_TIMEOUT_SECONDS=10

# URL pública do app, base do link de redefinição de senha (ex.: https://resqui.com.br).
# Obrigatória com EMAIL_ENABLED=true — sem ela o backend não sobe.
APP_URL_PUBLICA=